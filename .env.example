# ============================================================
# КОРНЕВОЙ .env — используется docker-compose.yml для подстановки ${VAR}.
# Копировать: cp .env.example .env   (файл .env в git не попадает)
# ПОРТЫ уже настроены как надо — не меняйте их без необходимости.
# Секреты приложения (JWT/API-ключи) — в python_test/.env (см. python_test/.env.example).
# ============================================================

# --- PostgreSQL (pgvector) ---
POSTGRES_USER=change_me_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=vectordb
POSTGRES_PORT=5432

# --- Ollama (GPU, эмбеддинги) ---
OLLAMA_PORT=11435

# --- n8n ---
N8N_PORT=5678
N8N_BIND_IP=0.0.0.0
# Публичный базовый URL РЕДАКТОРА n8n — открывается БРАУЗЕРОМ на хосте,
# поэтому здесь IP хоста в локальной сети (или localhost) — не имя контейнера:
N8N_EDITOR_BASE_URL=http://192.168.0.5:5678/
# Базовый URL вебхуков n8n для ДРУГИХ КОНТЕЙНЕРОВ (frontend) внутри docker-сети
# app_net. Внутри сети 127.0.0.1/IP хоста могут не работать — используйте
# имя сервиса n8n:
N8N_WEBHOOK_URL=http://n8n:5678/
# Режим вызова вебхука из Vue: live (/webhook/…, нужен активированный workflow)
# или test (/webhook-test/…, работает при тестовом запуске «Execute workflow»).
N8N_WEBHOOK_MODE=test
# Токен для запросов к n8n: Vue отправляет его как
# «Authorization: Bearer <N8N_AUTH_TOKEN>». Заполните, если вебхук n8n
# защищён (Header Auth); пустое значение — заголовок не отправляется.
# НЕ коммитите реальный токен в git (файл .env в gitignore).
N8N_AUTH_TOKEN=
TZ=Europe/Moscow

# --- RAG-индексатор (python_test, Swagger: http://localhost:8100/docs) ---
RAG_PORT=8100
RAG_BIND_IP=127.0.0.1

# --- Vue-фронтенд (frontend, http://localhost:5173) ---
FRONTEND_PORT=5173
FRONTEND_BIND_IP=0.0.0.0
