# ============================================================
# КОРНЕВОЙ .env — копируется в .env (git-игнорируется): cp .env.example .env
# Используется docker-compose.yml для подстановки ${VAR} во всех сервисах.
# ============================================================

# --- PostgreSQL (pgvector) ---
POSTGRES_USER=change_me_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=vectordb
POSTGRES_PORT=5432

# --- Ollama ---
OLLAMA_PORT=11435

# --- n8n ---
N8N_PORT=5678
N8N_BIND_IP=0.0.0.0
# Публичный базовый URL редактора и вебхуков n8n (IP хоста в локальной сети):
N8N_EDITOR_BASE_URL=http://192.168.0.5:5678/
N8N_WEBHOOK_URL=http://192.168.0.5:5678/
TZ=Europe/Moscow

# --- Микросервис извлечения текста (python_app, порт 8000) ---
APP_PORT=8000
APP_BIND_IP=0.0.0.0
APP_WEBHOOK_URL=http://192.168.0.5:8000/

# --- RAG-индексатор (python_test, порт 8100) ---
RAG_PORT=8100
RAG_BIND_IP=127.0.0.1
