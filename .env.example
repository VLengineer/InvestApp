# Core configuration
APP_NAME=news_market_analyzer
LOG_LEVEL=INFO

# T-Invest API
TINVEST_API_KEY=your_tinvest_api_key_here
TINVEST_SANDBOX=false

# LLM Provider (GPTunnel aggregator)
LLM_PROVIDER=gptunnel
LLM_API_URL=https://gptunnel.ru/v1/chat/completions
LLM_API_KEY=your_gptunnel_api_key_here
LLM_DEFAULT_MODEL=qwen3.8
LLM_USE_WALLET_BALANCE=true

# Database Provider
DB_PROVIDER=sqlite
SQLITE_DB_PATH=./data/news_market.db

# RAG Configuration
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=5
EMBEDDING_DIM=384

# Embedding Provider Strategy (gptunnel or ollama)
EMBEDDING_PROVIDER=gptunnel

# GPTunnel Embedding Settings
GPTUNNEL_API_KEY=your_gptunnel_api_key_here
GPTUNNEL_EMBEDDING_MODEL=text-embedding-3-small
GPTUNNEL_API_URL=https://api.gptunnel.ru/v1

# Ollama Embedding Settings
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_API_URL=http://localhost:11434
