ENVIRONMENT=development          # development | production (production отключает /docs)
LOG_LEVEL=INFO
PORT=8200

# --- Безопасность (JWT HS256, единый секрет проекта) ---
JWT_SECRET_KEY=change_me_generate_at_least_32_chars_same_as_python_test
JWT_ISSUER=
JWT_AUDIENCE=
JWT_REQUIRE_EXP=false
JWT_LEEWAY_S=60

CALLBACK_SECRET=change_me_generate_at_least_16_chars

# --- PostgreSQL (совпадает с остальными сервисами, общая база vectordb) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vectordb
POSTGRES_USER=admin
POSTGRES_PASSWORD=sip4308
# Можно переопределить одной строкой (имеет приоритет над POSTGRES_*):
# DATABASE_URL=postgresql://user:pass@host:5432/db

# --- n8n ---
N8N_WEBHOOK_URL=http://n8n:5678/webhook/start_process
# Тестовый вебхук для POST /api/v1/scheduler/test-trigger (ручной триггер, без очереди)
N8N_TEST_WEBHOOK_URL=http://n8n:5678/webhook-test/start_process
N8N_WEBHOOK_JWT_TOKEN=
N8N_REQUEST_TIMEOUT_S=30

# --- Воркер (очередь FIFO: waiting -> processing -> completed|error) ---
POLL_INTERVAL_S=10
IDLE_POLL_INTERVAL_S=5
INACTIVE_CHECK_INTERVAL_S=5
SLEEP_AFTER_COMPLETED_S=600
SLEEP_AFTER_ERROR_S=300
TASK_WAIT_TIMEOUT_S=3600

# --- Фоновый генератор задач (producer) ---
# Каждые TASK_GENERATION_INTERVAL_S секунд создаёт новую задачу со статусом
# 'waiting' (пока планировщик активен). Если в очереди уже MAX_WAITING_TASKS
# задач 'waiting' — новая НЕ создаётся, в логи пишется WARNING.
TASK_GENERATION_ENABLED=true
TASK_GENERATION_INTERVAL_S=300     # 5 минут
MAX_WAITING_TASKS=10
# Период INFO-«пульса» воркера (очередь пуста/ждёт callback) и анти-спам лимита:
HEARTBEAT_LOG_EVERY_S=60
