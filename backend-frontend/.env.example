# ============================================================
# Секретный env микросервиса backend-frontend (читается pydantic-settings).
# Копировать: cp .env.example .env   (файл .env в git не попадает)
# Значения POSTGRES_* должны совпадать с корневым ../.env (docker-compose).
# ============================================================

ENVIRONMENT=development          # development | production (production отключает /docs)
LOG_LEVEL=INFO
PORT=8300

# --- PostgreSQL (совпадает с остальными сервисами, общая база vectordb) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vectordb
POSTGRES_USER=admin
POSTGRES_PASSWORD=sip4308
# Можно переопределить одной строкой (имеет приоритет над POSTGRES_*):
# DATABASE_URL=postgresql://user:pass@host:5432/db

# --- CORS (origin'ы браузера через запятую или *) ---
CORS_ALLOW_ORIGINS=*

# --- Real-time (период опроса новых записей для WebSocket-подписок, сек) ---
WS_POLL_INTERVAL_S=5
