SCHEDULER_PORT=8200
SCHEDULER_BIND_IP=127.0.0.1

RESTIC_REPOSITORY=/backup/repo
# Пароль шифрования репозитория restic (ОБЯЗАТЕЛЬНО, храните в безопасном месте!)
RESTIC_PASSWORD=sip4308
# S3 credentials (если RESTIC_REPOSITORY = s3:...)
RESTIC_AWS_ACCESS_KEY_ID=
RESTIC_AWS_SECRET_ACCESS_KEY=
RESTIC_AWS_DEFAULT_REGION=
# Backblaze B2 credentials (если RESTIC_REPOSITORY = b2:...)
RESTIC_B2_ACCOUNT_ID=
RESTIC_B2_ACCOUNT_KEY=
# Retention policy — сколько снимков хранить
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=6
# Cron schedule (формат cron: минута час день месяц день_недели)
# По умолчанию: каждый день в 18:00
RESTIC_CRON_SCHEDULE=0 2 * * *
# Имя хоста для тегирования снимков
RESTIC_HOST=n8n-server
# Запустить бэкап сразу при старте контейнера (true/false)
RESTIC_RUN_ON_STARTUP=false