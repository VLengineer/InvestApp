# ============================================================
# КОРНЕВОЙ .env — используется docker-compose.yml для подстановки ${VAR}.
# Копировать: cp .env.example .env   (файл .env в git не попадает)
# ПОРТЫ уже настроены как надо — не меняйте их без необходимости.
# Секреты приложения (JWT/API-ключи) — в python_test/.env (см. python_test/.env.example).
# ============================================================

# --- PostgreSQL (pgvector) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=sip4308
POSTGRES_DB=vectordb
POSTGRES_PORT=5432

# --- Ollama (GPU, эмбеддинги) ---
OLLAMA_PORT=11435

# --- n8n ---
N8N_PORT=5678
N8N_BIND_IP=0.0.0.0
# Публичный базовый URL РЕДАКТОРА n8n — открывается БРАУЗЕРОМ на хосте,
# поэтому здесь localhost/IP хоста (не имя контейнера!):
N8N_EDITOR_BASE_URL=http://localhost:5678/
# Базовый URL вебхуков n8n — используется ДРУГИМИ КОНТЕЙНЕРАМИ (frontend)
# внутри docker-сети app_net. 127.0.0.1 там указывает на сам контейнер
# вызывающей стороны, а не на n8n, поэтому только имя сервиса:
N8N_WEBHOOK_URL=http://n8n:5678/
# Режим вызова вебхука из Vue: live (/webhook/…, нужен активированный
# workflow) или test (/webhook-test/…, работает при тестовом запуске
# «Execute workflow» в редакторе n8n).
N8N_WEBHOOK_MODE=test
# Токен, который Vue подставляет в заголовок Authorization: Bearer <токен>
# при запросе к n8n. Если вебхук n8n не защищён авторизацией — оставьте
# пустым (заголовок отправляться не будет).
N8N_AUTH_TOKEN=
TZ=Europe/Moscow

# --- RAG-индексатор (python_test, Swagger: http://localhost:8100/docs) ---
RAG_PORT=8100
RAG_BIND_IP=127.0.0.1

# --- Vue-фронтенд (frontend, http://localhost:5173) ---
FRONTEND_PORT=5173
FRONTEND_BIND_IP=0.0.0.0
