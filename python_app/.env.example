# Микросервис извлечения текста (production). Копировать в .env: cp .env.example .env

# --- JWT-авторизация ---
JWT_SECRET=copy_the_real_secret_from_password_manager
JWT_ALGORITHM=HS256

# --- Внешний OCR API (вебхук n8n) ---
OCR_API_URL=http://n8n:5678/webhook/ocr
OCR_API_TIMEOUT=60

# --- Ограничения ---
MAX_FILE_SIZE_MB=50
