# ============================================================
# Секретный env микросервиса RAG-индексатора (читается приложением через pydantic-settings).
# Копировать: cp .env.example .env   (файл .env в git не попадает)
# Значения POSTGRES_* должны совпадать с корневым ../.env (docker-compose).
#
# СХЕМА ДОСТУПА УПРОЩЕНА: один бессрочный JWT-токен на всё.
# Админ-ключей (ADMIN_API_KEY) и машинных ключей (API_KEYS / X-API-Key) больше нет.
# Токен генерируется скриптом:  python get_token.py --secret "$JWT_SECRET_KEY"
# ============================================================

ENVIRONMENT=development          # development | production (production отключает /docs)
LOG_LEVEL=INFO

# --- Безопасность (только JWT HS256) ---
# Сгенерировать секрет: python secret.py
#   или: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=tr6vjH3N4jHlMy01qZrDieqDxcj0KHSARB4Qqn6sJliOxwIiBG9MyM3XBmyYWV43

# Необязательные поля (по умолчанию пустые — проверять нечего, любой корректно
# подписанный токен принимается). Заполняйте только если точно нужно:
JWT_ISSUER=
JWT_AUDIENCE=

# Требовать ли наличие exp во входящем токене. false (по умолчанию) — токены
# БЕЗ срока действия (бессрочные) валидны; если exp есть, он всё равно проверяется.
JWT_REQUIRE_EXP=false
# Допуск (leeway) при проверке exp/iat, секунды:
JWT_LEEWAY_S=60

# --- PostgreSQL (совпадает с корневым .env) ---
POSTGRES_HOST=postgres           # внутри docker-compose — по имени сервиса
POSTGRES_PORT=5432
POSTGRES_DB=vectordb
POSTGRES_USER=admin
POSTGRES_PASSWORD=sip4308

# --- n8n (микросервис news_analyzer) ---
# python_test НЕ пишет в БД — он пересылает новость на вебхук n8n.
# Полный URL = N8N_BASE_URL + N8N_NEWS_WEBHOOK_PATH (путь вынесен в env).
N8N_BASE_URL=http://n8n:5678/
N8N_NEWS_WEBHOOK_PATH=/webhook/news_analizer
N8N_REQUEST_TIMEOUT_S=30

# --- Ollama (эмбеддинги) ---
OLLAMA_BASE_URL=http://ollama:11435/
EMBEDDING_MODEL=hf.co/unsloth/embeddinggemma-2-GGUF:UD-Q4_K_XL
EMBEDDING_DIM=768

# --- Knowledge base ---
KB_ROOT=/app/knowledge_base
COMMON_DIR_NAMES=_all