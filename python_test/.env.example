# ============================================================
# Секретный env микросервиса RAG-индексатора (читается приложением через pydantic-settings).
# Копировать: cp .env.example .env   (файл .env в git не попадает)
# Значения POSTGRES_* должны совпадать с корневаем ../.env (docker-compose).
# ============================================================

ENVIRONMENT=development          # development | production (production отключает /docs)
LOG_LEVEL=INFO

# --- Безопасность (JWT HS256 + машинные ключи) ---
# Сгенерировать секрет: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_generate_at_least_32_chars
JWT_ISSUER=rag-indexer
JWT_AUDIENCE=rag-indexer
# Требовать ли наличие exp во входящем токене. false — допускаются БЕССРОЧНЫЕ
# токены (без exp); если exp есть, он всё равно проверяется.
JWT_REQUIRE_EXP=false
# Допуск (leeway) при проверке exp/iat, секунды:
JWT_LEEWAY_S=60
# TTL выдаваемого через POST /auth/token токена; 0 = бессрочный (без exp):
ACCESS_TOKEN_TTL_S=0
# Ключи X-API-Key для машинных вызовов (n8n): JSON-список ИЛИ строка через запятую.
# ВАЖНО: кавычки внутри списка обязательны, значение не должно быть оборванным,
# иначе будет получен мусорный ключ и n8n получит 401. Примеры:
#   API_KEYS=["key_abc","key_def"]
#   API_KEYS=key_abc,key_def
API_KEYS=["change_me_n8n_key"]
# Ключ, разрешающий выдачу JWT через POST /auth/token:
ADMIN_API_KEY=change_me_admin_key

# --- PostgreSQL (совпадает с корневым .env) ---
POSTGRES_HOST=postgres           # внутри docker-compose — по имени сервиса
POSTGRES_PORT=5432
POSTGRES_DB=vectordb
POSTGRES_USER=change_me_user
POSTGRES_PASSWORD=change_me_strong_password

# --- Ollama (эмбеддинги) ---
OLLAMA_BASE_URL=http://ollama:11435
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# --- Knowledge base ---
KB_ROOT=/app/knowledge_base
