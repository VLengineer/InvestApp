# RAG-индексатор базы знаний. Копировать в .env: cp .env.example .env

# --- PostgreSQL + pgvector (совпадает с корневой .env docker-compose) ---
DATABASE_URL=postgresql://change_me_user:change_me_strong_password@postgres:5432/vectordb
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# --- Ollama (эмбеддинги) ---
OLLAMA_BASE_URL=http://ollama:11434/api
OLLAMA_EMBED_MODEL=embeddinggemma-2
EMBEDDING_DIM=768            # проверяется при старте сервиса против реальной модели
EMBED_BATCH_SIZE=8           # текстов за один запрос к Ollama
EMBED_REQUEST_TIMEOUT=120    # секунды

# --- JWT-авторизация эндпоинтов ---
JWT_SECRET=copy_the_real_secret_from_password_manager
JWT_ALGORITHM=HS256

# --- Каталог базы знаний (в Docker примонтирован как volume) ---
KNOWLEDGE_BASE_DIR=/data/knowledge_base
MAX_JSON_FILE_SIZE_MB=10
INDEX_CONCURRENCY=2          # параллельных батча эмбеддингов
