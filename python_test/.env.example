# RAG-индексатор базы знаний. Копировать в .env: cp .env.example .env

# --- PostgreSQL + pgvector (учётные данные из корневого .env docker-compose) ---
DATABASE_URL=postgresql://change_me_user:change_me_strong_password@postgres:5432/vectordb
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# --- Ollama (эмбеддинги) --- порт 11435 (OLLAMA_PORT в корневом .env docker-compose)
OLLAMA_BASE_URL=http://ollama:11435/api
OLLAMA_EMBED_MODEL=embeddinggemma-2
EMBEDDING_DIM=768            # проверяется при старте против реальной модели
EMBED_BATCH_SIZE=8           # текстов за один запрос к Ollama
EMBED_REQUEST_TIMEOUT=120    # секунды
EMBED_MAX_RETRIES=3

# --- Каталог базы знаний (в Docker примонтирован как volume read-only) ---
KNOWLEDGE_BASE_DIR=/data/knowledge_base
MAX_JSON_FILE_SIZE_MB=10
INDEX_CONCURRENCY=2          # параллельных запросов эмбеддингов

# --- JWT-авторизация эндпоинтов (/api/v1/*, кроме /health) ---
# Если оставить пустым — авторизация отключена (только для локальной разработки!)
JWT_SECRET=
JWT_ALGORITHM=HS256

LOG_LEVEL=INFO
